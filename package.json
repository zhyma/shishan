{
  "name": "shishan-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "AI-authored code narratives with local, incremental visualization.",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "overrides": {
    "tree-sitter-c": "0.23.2"
  },
  "scripts": {
    "build:protocol": "npm run build -w @shishan/protocol",
    "build:core": "npm run build -w @shishan/core",
    "build:cli": "npm run build -w @shishan/cli",
    "build:packages": "npm run build:protocol && npm run build:core && npm run build:cli",
    "build:web": "npm run build -w @shishan/web",
    "build": "npm run build:packages && npm run build:web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run build:packages && vitest run",
    "test:watch": "vitest",
    "shishan": "node apps/cli/dist/main.js",
    "dev:web": "npm run dev -w @shishan/web",
    "benchmark:incremental": "npm run build:packages && node scripts/benchmark-incremental.mts",
    "legacy:compile": "tsc -p tsconfig.json",
    "legacy:test:fold": "node scripts/smoke-test.js"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/vscode": "1.85.0",
    "tree-sitter-c": "0.23.2",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
